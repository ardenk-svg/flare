{
  "name": "flare",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "description": "A clearly labelled incident-response coordination simulation.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:terminal": "npm run dev:terminal --workspace @flare/agent",
    "agent:imessage": "npm run dev:imessage --workspace @flare/agent",
    "agent:echo:terminal": "npm run dev:echo:terminal --workspace @flare/agent",
    "agent:echo:imessage": "npm run dev:echo:imessage --workspace @flare/agent",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "check:data:live": "npm run check --workspace @flare/data",
    "check:module": "npm run typecheck --prefix spacetime && npm run build --prefix spacetime",
    "install:module": "npm ci --prefix spacetime --ignore-scripts --no-audit --no-fund",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
