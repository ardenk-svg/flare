# Photon Spectrum Cloud credentials for the iMessage worker.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Spectrum reads LOG_LEVEL when no explicit SDK log level is supplied.
LOG_LEVEL=info

# Person 2's Gemini integration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_THINKING_LEVEL=LOW
GEMINI_EVAL_DELAY_MS=5000

# Person 3's SpacetimeDB adapter and authorized agent identity.
SPACETIMEDB_URI=
SPACETIMEDB_DATABASE=
SPACETIMEDB_AGENT_TOKEN=

# Optional persistent agent/runtime tuning.
FLARE_AGENT_STATE_PATH=
FLARE_SPACETIME_BIN=
FLARE_NOTIFICATION_POLL_MS=2000
FLARE_NOTIFICATION_MAX_ATTEMPTS=5
FLARE_LOCATION_TIMEOUT_MS=5000
FLARE_INTAKE_RETRY_POLL_MS=5000

# One-phone Find My bridge is enabled by default; set 0 to disable it.
# Current-location pins work independently of Find My.
FLARE_FIND_MY_ENABLED=1
# Optional caller allowlist in E.164 format; otherwise binds the first direct caller.
FLARE_DEMO_PHONE=
