{
  "name": "@flare/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:imessage": "tsx src/imessage.ts",
    "dev:terminal": "tsx src/terminal.ts",
    "start:imessage": "node dist/imessage.js",
    "start:terminal": "node dist/terminal.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "@spectrum-ts/terminal": "12.10.1"
  }
}
